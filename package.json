    "@libp2p/identify": "^4.1.12",
    "@libp2p/websockets": "^10.1.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "libp2p": "^3.3.8",
    "lucide-react": "^1.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.58.2",
    "postcss": "^8.5.26"
  }
