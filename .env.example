# OmniCast Environment Variables Example

# Port for the local relay/signaling server (default: 10000)
PORT=10000

# External hostname for public deployment (e.g., myserver.onrender.com)
# RENDER_EXTERNAL_HOSTNAME=

# Topology Scale Limits
MAX_VIEWERS_PER_BROADCAST=500
MAX_TREE_DEPTH=4

# WebRTC STUN/TURN Configuration (comma-separated URLs supported)
VITE_TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_PASSWORD=openrelayproject
